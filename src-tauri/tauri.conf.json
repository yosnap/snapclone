{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapclone",
  "version": "../package.json",
  "identifier": "com.paulo.snapclone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Snapclone",
        "width": 1260,
        "height": 800,
        "center": true,
        "visible": false,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 yosnap. Licencia MIT.",
    "shortDescription": "Capturas de pantalla embellecidas",
    "longDescription": "Snapclone hace capturas de pantalla y las deja listas para compartir: fondo, margen, esquinas, sombra, anotaciones y tachado automático de datos sensibles.",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 190
        }
      }
    }
  }
}
